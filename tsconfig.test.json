{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "rootDir": ".",
        "outDir": "./.typecheck",
        "tsBuildInfoFile": "./.typecheck/.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "packages/*/examples/**/*.ts", "vitest.config.ts"],
    "exclude": ["**/dist/**", "**/node_modules/**"]
}
