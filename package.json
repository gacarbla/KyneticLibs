{
    "name": "@kyneticweb/libs",
    "version": "0.2.0",
    "private": true,
    "description": "Kynetic Web Libraries Monorepo",
    "type": "module",
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gacarbla/KyneticLibs.git"
    },
    "bugs": {
        "email": "gacarbla@gacarbla.es",
        "url": "https://github.com/gacarbla/KyneticLibs/issues/new"
    },
    "author": {
        "name": "gacarbla",
        "email": "gacarbla@gacarbla.es",
        "url": "https://gacarbla.es"
    },
    "license": "CUSTOM-NON-COMMERCIAL",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean && node scripts/clean.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p examples/counter/tsconfig.json && tsc -p examples/benchmark/tsconfig.json && tsc -p examples/ssr/tsconfig.json && tsc -p examples/kit/tsconfig.json",
        "dev:example": "npm run dev -w @kyneticweb/example-counter",
        "build:example": "npm run build -w @kyneticweb/example-counter",
        "dev:kit": "npm run dev -w @kyneticweb/example-kit",
        "build:kit": "npm run build -w @kyneticweb/example-kit",
        "dev:benchmark": "npm run dev -w @kyneticweb/example-benchmark",
        "build:benchmark": "npm run build -w @kyneticweb/example-benchmark",
        "build:ssr": "npm run build -w @kyneticweb/example-ssr",
        "start:ssr": "npm run start -w @kyneticweb/example-ssr",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "smoke": "node scripts/smoke.mjs",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "npm run build && changeset publish"
    },
    "devDependencies": {
        "@babel/core": "^8.1.0",
        "@babel/plugin-syntax-jsx": "^8.0.1",
        "@babel/plugin-syntax-typescript": "^8.0.3",
        "@changesets/cli": "^3.0.3",
        "@eslint/js": "^10.0.0",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.10.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.0",
        "happy-dom": "^21.0.4",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    }
}
