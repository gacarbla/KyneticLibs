{
    "name": "@kyneticweb/console",
    "version": "0.2.0",
    "description": "Coloured console logging with file persistence and an optional blessed interface.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "console",
        "cli",
        "logger",
        "terminal",
        "blessed",
        "kyneticweb"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gacarbla/KyneticLibs.git",
        "directory": "packages/console"
    },
    "bugs": {
        "email": "gacarbla@gacarbla.es",
        "url": "https://github.com/gacarbla/KyneticLibs/issues/new"
    },
    "author": {
        "name": "gacarbla",
        "email": "gacarbla@gacarbla.es",
        "url": "https://gacarbla.es"
    },
    "license": "CUSTOM-NON-COMMERCIAL",
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean"
    },
    "dependencies": {
        "@kyneticweb/utils": "^0.1.0"
    },
    "optionalDependencies": {
        "blessed": "^0.1.81"
    },
    "devDependencies": {
        "@types/blessed": "^0.1.25",
        "@types/node": "^24.10.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
