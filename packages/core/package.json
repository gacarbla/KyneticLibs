{
    "name": "@kyneticweb/core",
    "version": "0.1.0",
    "description": "Compose the Kynetic libraries into a single, fully typed object.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "core",
        "composition",
        "dependency-injection",
        "kyneticweb"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gacarbla/KyneticLibs.git",
        "directory": "packages/core"
    },
    "bugs": {
        "email": "gacarbla@gacarbla.es",
        "url": "https://github.com/gacarbla/KyneticLibs/issues/new"
    },
    "author": {
        "name": "gacarbla",
        "email": "gacarbla@gacarbla.es",
        "url": "https://gacarbla.es"
    },
    "license": "CUSTOM-NON-COMMERCIAL",
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean"
    },
    "dependencies": {
        "@kyneticweb/console": "^0.2.0",
        "@kyneticweb/container": "^0.2.0",
        "@kyneticweb/counter": "^0.2.0",
        "@kyneticweb/parser": "^0.2.0",
        "@kyneticweb/utils": "^0.1.0",
        "@kyneticweb/versions": "^0.2.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
