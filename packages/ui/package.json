{
    "name": "@kyneticweb/ui",
    "version": "0.2.0",
    "description": "Accessible, themeable components for the Kynetic runtime: buttons, cards, tabs, dialogs and more.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./styles.css"
    },
    "files": [
        "dist",
        "styles.css"
    ],
    "sideEffects": [
        "*.css"
    ],
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "ui",
        "components",
        "accessibility",
        "kyneticweb"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/gacarbla/KyneticLibs.git",
        "directory": "packages/ui"
    },
    "bugs": {
        "email": "gacarbla@gacarbla.es",
        "url": "https://github.com/gacarbla/KyneticLibs/issues/new"
    },
    "author": {
        "name": "gacarbla",
        "email": "gacarbla@gacarbla.es",
        "url": "https://gacarbla.es"
    },
    "license": "CUSTOM-NON-COMMERCIAL",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean"
    },
    "dependencies": {
        "@kyneticweb/dom": "^0.2.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.0"
    }
}
