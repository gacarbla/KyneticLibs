{
    "name": "@kyneticweb/dom",
    "version": "0.1.0",
    "description": "Fine-grained DOM renderer with typed TSX, components and context.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./jsx-runtime": {
            "types": "./dist/jsx-runtime.d.ts",
            "import": "./dist/jsx-runtime.js"
        },
        "./jsx-dev-runtime": {
            "types": "./dist/jsx-dev-runtime.d.ts",
            "import": "./dist/jsx-dev-runtime.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "dom",
        "tsx",
        "signals",
        "components",
        "kyneticweb"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gacarbla/KyneticLibs.git",
        "directory": "packages/dom"
    },
    "bugs": {
        "email": "gacarbla@gacarbla.es",
        "url": "https://github.com/gacarbla/KyneticLibs/issues/new"
    },
    "author": {
        "name": "gacarbla",
        "email": "gacarbla@gacarbla.es",
        "url": "https://gacarbla.es"
    },
    "license": "CUSTOM-NON-COMMERCIAL",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean"
    },
    "dependencies": {
        "@kyneticweb/reactive": "^0.1.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.0"
    }
}
