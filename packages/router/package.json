{
    "name": "@kyneticweb/router",
    "version": "0.2.0",
    "description": "Typed router for the Kynetic DOM runtime: path, hash and memory strategies.",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "router",
        "spa",
        "typescript",
        "kyneticweb"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gacarbla/KyneticLibs.git",
        "directory": "packages/router"
    },
    "bugs": {
        "email": "gacarbla@gacarbla.es",
        "url": "https://github.com/gacarbla/KyneticLibs/issues/new"
    },
    "author": {
        "name": "gacarbla",
        "email": "gacarbla@gacarbla.es",
        "url": "https://gacarbla.es"
    },
    "license": "CUSTOM-NON-COMMERCIAL",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean"
    },
    "dependencies": {
        "@kyneticweb/dom": "^0.2.0",
        "@kyneticweb/reactive": "^0.2.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.0"
    }
}
